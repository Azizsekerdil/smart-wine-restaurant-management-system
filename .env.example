# ===========================================================================
# Wine House - Örnek ortam yapılandırması
#
# BU DOSYAYI KOPYALAYIN:   copy .env.example .env
# ve `.env` içine gerçek değerleri yazın.
#
# !!! ÖNEMLİ GÜVENLİK UYARISI !!!
# - `.env` dosyası `.gitignore` içindedir ve ASLA GitHub'a gönderilmez.
# - Bu `.env.example` dosyasına GERÇEK anahtar yazmayın; yalnızca değişken
#   adları ve örnek/boş değerler bulunmalıdır.
# - API anahtarlarını tercihen uygulama içindeki "Ayarlar > Yapay Zekâ"
#   ekranından girin; anahtarlar Windows'ta şifrelenmiş olarak saklanır.
# ===========================================================================

# ---------------------------------------------------------------------------
# 1) TEMEL UYGULAMA
# ---------------------------------------------------------------------------
# Django gizli anahtarı. Boş bırakılırsa kurulum betiği otomatik üretir.
DJANGO_SECRET_KEY=

# dev | prod  (prod: DEBUG kapalı, güvenlik başlıkları açık)
WINEHOUSE_ENV=dev

# Hata ayıklama modu. ÜRETİMDE MUTLAKA False olmalıdır.
DJANGO_DEBUG=True

# Virgülle ayrılmış izinli host listesi
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# Arayüz varsayılan dili: tr | en
WINEHOUSE_DEFAULT_LANGUAGE=tr

# Zaman dilimi
WINEHOUSE_TIME_ZONE=Europe/Istanbul

# Yerel sunucu portu
WINEHOUSE_PORT=8000

# ---------------------------------------------------------------------------
# 2) VERİTABANI
# ---------------------------------------------------------------------------
# sqlite (varsayılan, tek makine) | postgres (çok kullanıcılı işletme)
WINEHOUSE_DB_ENGINE=sqlite

# SQLite dosya yolu (WINEHOUSE_DB_ENGINE=sqlite iken kullanılır)
WINEHOUSE_SQLITE_PATH=var/winehouse.sqlite3

# PostgreSQL ayarları (WINEHOUSE_DB_ENGINE=postgres iken kullanılır)
WINEHOUSE_PG_NAME=winehouse
WINEHOUSE_PG_USER=winehouse
WINEHOUSE_PG_PASSWORD=
WINEHOUSE_PG_HOST=127.0.0.1
WINEHOUSE_PG_PORT=5432

# ---------------------------------------------------------------------------
# 3) VERİ KORUMA / ŞİFRELEME
# ---------------------------------------------------------------------------
# Hassas alanların (müşteri telefonu, e-posta, API anahtarları) şifrelenmesi
# için kullanılan Fernet anahtarı. Kurulum betiği otomatik üretir.
# ÜRETMEK İÇİN: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
WINEHOUSE_FIELD_ENCRYPTION_KEY=

# Yedek dosyalarının şifrelenmesi (True/False)
WINEHOUSE_BACKUP_ENCRYPTION=True

# Yedeklerin saklanacağı klasör
WINEHOUSE_BACKUP_DIR=backups

# Yedek saklama politikası (gün)
WINEHOUSE_BACKUP_RETENTION_DAYS=30

# ---------------------------------------------------------------------------
# 4) YAPAY ZEKÂ - GENEL
# ---------------------------------------------------------------------------
# Varsayılan sağlayıcı: mock | lmstudio | anthropic | nvidia
# GİZLİLİK VARSAYILANI: yerel LM Studio tercih edilir.
WINEHOUSE_AI_DEFAULT_PROVIDER=lmstudio

# Yerel model önceliği açıkken bulut yalnızca yerel başarısız olursa kullanılır
WINEHOUSE_AI_PREFER_LOCAL=True

# Bulut yedekleme (fallback) sırası - virgülle ayrılmış
WINEHOUSE_AI_FALLBACK_ORDER=lmstudio,anthropic,nvidia,mock

# Gizlilik modu: True iken kişisel veriler buluta gönderilmeden önce maskelenir
WINEHOUSE_AI_PRIVACY_MODE=True

# Bulut sağlayıcıya gönderim tamamen yasak (yalnızca yerel + mock)
WINEHOUSE_AI_LOCAL_ONLY=False

# Aylık maliyet üst sınırı (USD). 0 = sınırsız (önerilmez)
WINEHOUSE_AI_MONTHLY_COST_LIMIT_USD=10

# ---------------------------------------------------------------------------
# 5) YAPAY ZEKÂ - LM STUDIO (YEREL)
# ---------------------------------------------------------------------------
WINEHOUSE_LMSTUDIO_BASE_URL=http://localhost:1234/v1
# Boş bırakılırsa /v1/models listesinden ilk uygun model otomatik seçilir
WINEHOUSE_LMSTUDIO_MODEL=
WINEHOUSE_LMSTUDIO_TIMEOUT=60
# LM Studio yerel sunucusu anahtar istemez; boş bırakın.
WINEHOUSE_LMSTUDIO_API_KEY=

# ---------------------------------------------------------------------------
# 6) YAPAY ZEKÂ - ANTHROPIC CLAUDE (BULUT)
# ---------------------------------------------------------------------------
# GERÇEK ANAHTARI BURAYA DEĞİL, `.env` DOSYASINA YAZIN.
# Boş bırakıldığında sağlayıcı NOT_CONFIGURED durumundadır ve HİÇBİR ağ
# çağrısı yapmaz; yerel yapay zekâ ve yapay zekâ dışı işlevler çalışmayı sürdürür.
ANTHROPIC_API_KEY=
WINEHOUSE_ANTHROPIC_BASE_URL=https://api.anthropic.com/v1
WINEHOUSE_ANTHROPIC_MODEL=
WINEHOUSE_ANTHROPIC_TIMEOUT=60

# ---------------------------------------------------------------------------
# 7) YAPAY ZEKÂ - NVIDIA (BULUT)
# ---------------------------------------------------------------------------
# GERÇEK ANAHTARI BURAYA DEĞİL, `.env` DOSYASINA YAZIN.
# Boş bırakıldığında sağlayıcı NOT_CONFIGURED durumundadır ve HİÇBİR ağ
# çağrısı yapmaz; yerel yapay zekâ ve yapay zekâ dışı işlevler çalışmayı sürdürür.
NVIDIA_API_KEY=
WINEHOUSE_NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
WINEHOUSE_NVIDIA_MODEL=
WINEHOUSE_NVIDIA_TIMEOUT=60

# ---------------------------------------------------------------------------
# 8) AI DEVELOPMENT STUDIO (GELİŞTİRİCİ TERMİNALİ)
# ---------------------------------------------------------------------------
# Üretim modunda VARSAYILAN OLARAK KAPALIDIR.
WINEHOUSE_DEVSTUDIO_ENABLED=False

# Yazma izni verilen tek çalışma alanı. Bu klasörün dışına yazılamaz.
# Kurulumun yapıldığı klasörün TAM YOLU. Örn: C:\WineHouse
WINEHOUSE_DEVSTUDIO_WORKSPACE=

# Komut çalıştırma izni (False iken yalnızca öneri üretilir, komut çalışmaz)
WINEHOUSE_DEVSTUDIO_ALLOW_COMMANDS=False

# ---------------------------------------------------------------------------
# 9) ÖDEME / MALİ ENTEGRASYON  (YALNIZCA SANDBOX)
# ---------------------------------------------------------------------------
# CANLI ÖDEME VARSAYILAN OLARAK KAPALIDIR ve kullanıcı onayı olmadan açılmaz.
WINEHOUSE_PAYMENT_MODE=sandbox
WINEHOUSE_EINVOICE_MODE=sandbox
